# Copy this file to .env and fill in the values. Never commit .env.

# ---- Server ----
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the app (Hostinger/Nginx/LiteSpeed = 1).
# Needed so rate limiting sees the real client IP.
TRUST_PROXY=1
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=https://newkhan.com,https://www.newkhan.com

# ---- Supabase (Dashboard -> Project Settings -> API) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Supabase Postgres (Dashboard -> Connect -> Session pooler) ----
# Use the SESSION pooler URL (IPv4-compatible, port 5432), not the direct db.* host.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_POOL_MAX=10
# Optional but recommended: path to the Supabase CA certificate
# (Dashboard -> Database -> SSL Configuration -> Download certificate).
# When set, the server certificate is fully verified.
DB_SSL_CA_PATH=
# Vercel: the same certificate as text instead of a path (paste the whole file; or one line with \n for line breaks).
# DB_SSL_CA=

# ---- Serverless hosting only (Vercel) ----
# Protects GET /api/v1/internal/expire-bookings, which releases unpaid seat holds (Vercel Cron sends it).
# Leave empty on a VPS / Hostinger: the server then runs that job itself every minute.
# CRON_SECRET=

# ---- Auth redirects ----
# Where Supabase sends users after clicking the password-reset / confirm email link.
AUTH_REDIRECT_URL=https://newkhan.com/auth/callback

# ---- Booking rules ----
BOOKING_HOLD_MINUTES=20
MAX_SEATS_PER_BOOKING=6

# ---- Payments ----
# Shared secret used to verify webhook signatures (HMAC-SHA256). Min 32 chars.
# PAYMENT_WEBHOOK_SECRET= (optional: only for the generic relay webhook; min 32 chars)

# Public URLs, used to build payment return links.
# APP_URL = the frontend; API_PUBLIC_URL = this API as reachable from the internet (no /api/v1).
APP_URL=https://newkhan.com
API_PUBLIC_URL=https://api.newkhan.com

# ---- Round Trip Report ----
# Voucher QR codes open APP_URL/r/<token>. false = staff must sign in to see the report (default);
# true = anyone holding the link can view it read-only.
PUBLIC_TRIP_REPORT=false

# ---- Safepay (leave SAFEPAY_API_KEY empty to disable) ----
# Safepay dashboard -> Developer -> API (use sandbox.getsafepay.com for test keys).
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
# Safepay dashboard -> Developer -> Webhooks -> shared secret
SAFEPAY_WEBHOOK_SECRET=
# Which payment methods go through Safepay checkout (comma-separated).
SAFEPAY_METHODS=card,jazzcash,easypaisa
