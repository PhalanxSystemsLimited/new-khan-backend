{
  "name": "new-khan-backend",
  "version": "1.0.0",
  "description": "New Khan Bus Service booking system - REST API (Express + Supabase)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
